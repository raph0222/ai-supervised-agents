# Copy to .env. Every value here is optional, the app boots without any of it.
# Only the chat endpoint fails when Vertex is unconfigured.

# --- Vertex AI (if absent = chat returns a config error) -------------
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_LLM_MODEL=gemini-2.5-flash
VERTEX_EMBEDDING_MODEL=text-embedding-005

# Set your path to your google gemini vertex credentials
# container, which reads it via GOOGLE_APPLICATION_CREDENTIALS internally.
GOOGLE_CREDENTIALS_FILE=/path/to/service-account.json

# --- Seeding ----------------------------------------------------------------
SEED_ON_STARTUP=true
# SEED_DIR=../seed

# --- Single user ------------------------------------------------------------
DEFAULT_CUSTOMER_ID=CUST-0001

# --- Database ---------------------------------------------------------------
# Compose sets this for the api container. Override for local (non-docker) runs:
# DATABASE_URL=postgresql+psycopg://northbridge:northbridge@localhost:5433/northbridge

# --- Policy thresholds (DB-backed) -----------
REFUND_AUTO_APPROVE_UNDER_CENTS=5000
RETURN_WINDOW_DAYS=30
RISK_SCORE_APPROVAL_THRESHOLD=70